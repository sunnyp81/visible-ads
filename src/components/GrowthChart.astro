---
interface Props {
  title?: string;
  bars: { label: string; value: number; color?: string }[];
}

const { title, bars } = Astro.props;
const maxValue = Math.max(...bars.map(b => b.value));
---

<div class="growth-chart" data-animate>
  {title && <h3 class="font-heading text-lg font-bold text-navy mb-6">{title}</h3>}
  <div class="space-y-4">
    {bars.map((bar, i) => (
      <div class="growth-bar-row">
        <div class="flex justify-between items-center mb-1.5">
          <span class="text-sm font-medium text-slate-dark">{bar.label}</span>
          <span class="text-sm font-bold text-electric bar-value" data-target={bar.value}>0%</span>
        </div>
        <div class="h-3 bg-gray-100 rounded-full overflow-hidden">
          <div
            class="growth-bar h-full rounded-full transition-all duration-1000 ease-out"
            data-width={`${(bar.value / maxValue) * 100}%`}
            style={`width: 0%; background: linear-gradient(90deg, ${bar.color || '#2563EB'}, ${bar.color ? bar.color + '80' : '#3B82F6'});`}
            data-delay={i * 150}
          ></div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const charts = document.querySelectorAll('.growth-chart');
  const chartObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const bars = entry.target.querySelectorAll('.growth-bar') as NodeListOf<HTMLElement>;
      const values = entry.target.querySelectorAll('.bar-value') as NodeListOf<HTMLElement>;
      bars.forEach((bar, i) => {
        const delay = parseInt(bar.dataset.delay || '0');
        const targetWidth = bar.dataset.width || '0%';
        setTimeout(() => {
          bar.style.width = targetWidth;
        }, delay);
      });
      values.forEach((val, i) => {
        const target = parseInt(val.dataset.target || '0');
        const delay = i * 150;
        setTimeout(() => {
          let start = 0;
          const duration = 1000;
          const startTime = performance.now();
          function tick(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            val.textContent = Math.floor(target * eased) + '%';
            if (progress < 1) requestAnimationFrame(tick);
            else val.textContent = target + '%';
          }
          requestAnimationFrame(tick);
        }, delay);
      });
      chartObserver.unobserve(entry.target);
    });
  }, { threshold: 0.2 });
  charts.forEach((c) => chartObserver.observe(c));
</script>
