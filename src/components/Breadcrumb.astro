---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
  <ol class="flex items-center gap-2 text-sm text-slate">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <svg class="w-3 h-3 text-slate-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>}
        {item.href ? (
          <a href={item.href} class="hover:text-electric transition-colors">{item.label}</a>
        ) : (
          <span class="text-navy font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
