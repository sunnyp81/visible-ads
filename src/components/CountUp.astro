---
interface Props {
  value: string;
  label: string;
  prefix?: string;
  suffix?: string;
  duration?: number;
}

const { value, label, prefix = '', suffix = '', duration = 2000 } = Astro.props;
const numericValue = parseFloat(value.replace(/[^0-9.]/g, ''));
const hasDecimal = value.includes('.');
---

<div class="count-up-card glass-card p-6 sm:p-8 text-center group hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
  <div class="text-4xl sm:text-5xl font-heading font-extrabold text-electric mb-2">
    <span class="count-prefix">{prefix}</span><span class="count-value" data-target={numericValue} data-duration={duration} data-decimal={hasDecimal ? 'true' : 'false'}>0</span><span class="count-suffix">{suffix}</span>
  </div>
  <div class="text-sm font-semibold text-navy uppercase tracking-wide">{label}</div>
  <div class="mt-3 h-1 w-0 bg-gradient-to-r from-electric to-cyan-400 rounded-full transition-all duration-1000 group-[.counted]:w-full mx-auto"></div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const counters = document.querySelectorAll('.count-value');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseFloat(el.dataset.target || '0');
        const duration = parseInt(el.dataset.duration || '2000');
        const useDecimal = el.dataset.decimal === 'true';
        const card = el.closest('.count-up-card');
        const startTime = performance.now();

        function animate(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = target * eased;
          el.textContent = useDecimal ? current.toFixed(1) : Math.floor(current).toLocaleString();
          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            el.textContent = useDecimal ? target.toFixed(1) : target.toLocaleString();
            card?.classList.add('counted');
          }
        }
        requestAnimationFrame(animate);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.3 });
    counters.forEach((c) => observer.observe(c));
  });
</script>
