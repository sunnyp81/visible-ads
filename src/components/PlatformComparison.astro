---
const platforms = [
  { name: 'Google Ads', tagline: 'High-intent search traffic', scores: [5, 5, 4, 3, 5], highlight: true },
  { name: 'Bing Ads', tagline: 'Lower-cost, older demographics', scores: [3, 4, 5, 3, 3] },
  { name: 'Meta', tagline: 'Awareness & retargeting at scale', scores: [5, 2, 4, 2, 4] },
  { name: 'Amazon', tagline: 'Product marketplace dominance', scores: [4, 5, 3, 1, 5] },
  { name: 'LinkedIn', tagline: 'B2B decision-maker targeting', scores: [3, 3, 2, 5, 1] },
];

const metrics = ['Reach', 'Intent', 'Cost Efficiency', 'B2B Strength', 'eCommerce'];
---
<div id="platform-compare" class="overflow-x-auto -mx-4 px-4">
  <table class="w-full min-w-[640px]">
    <thead>
      <tr>
        <th class="text-left py-4 pr-4 w-36"></th>
        {platforms.map((p) => (
          <th
            class:list={[
              'platform-col py-4 px-3 text-center transition-colors duration-200 rounded-t-xl',
              p.highlight ? 'bg-electric/5' : ''
            ]}
            data-platform={p.name}
          >
            <p class:list={['font-heading text-sm sm:text-base font-bold mb-1', p.highlight ? 'text-electric' : 'text-navy']}>{p.name}</p>
            <p class="text-xs text-slate hidden sm:block">{p.tagline}</p>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {metrics.map((metric, mi) => (
        <tr class="border-t border-gray-100">
          <td class="py-4 pr-4">
            <p class="text-sm font-semibold text-navy">{metric}</p>
          </td>
          {platforms.map((p) => (
            <td
              class:list={[
                'platform-col py-4 px-3 text-center transition-colors duration-200',
                p.highlight ? 'bg-electric/5' : '',
                mi === metrics.length - 1 ? 'rounded-b-xl' : ''
              ]}
              data-platform={p.name}
            >
              <div class="flex justify-center gap-1">
                {[1,2,3,4,5].map((dot) => (
                  <div
                    class:list={[
                      'platform-dot w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full transition-all duration-500',
                      dot <= p.scores[mi]
                        ? (p.highlight ? 'bg-electric shadow-sm shadow-electric/30' : 'bg-navy/60')
                        : 'bg-gray-200'
                    ]}
                    style={`transition-delay: ${(mi * 5 + dot) * 60}ms; transform: scale(0);`}
                  ></div>
                ))}
              </div>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const table = document.getElementById('platform-compare');
    if (!table) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        table.querySelectorAll('.platform-dot').forEach((dot: Element) => {
          (dot as HTMLElement).style.transform = 'scale(1)';
        });
      });
    }, { threshold: 0.15 });

    observer.observe(table);

    const cols = table.querySelectorAll('th[data-platform]') as NodeListOf<HTMLElement>;
    cols.forEach((col) => {
      const name = col.dataset.platform;
      col.addEventListener('mouseenter', () => {
        table.querySelectorAll('.platform-col').forEach((c: Element) => {
          const el = c as HTMLElement;
          if (el.dataset.platform === name) {
            el.classList.add('bg-electric/10');
          } else {
            el.style.opacity = '0.5';
          }
        });
      });
      col.addEventListener('mouseleave', () => {
        table.querySelectorAll('.platform-col').forEach((c: Element) => {
          const el = c as HTMLElement;
          el.classList.remove('bg-electric/10');
          el.style.opacity = '';
        });
      });
    });
  });
</script>
