---
---
<div id="ppc-funnel" class="max-w-3xl mx-auto">
  <div class="space-y-4">
    <div class="funnel-stage opacity-0" data-delay="0">
      <div class="relative bg-electric/10 border border-electric/20 rounded-2xl p-6 sm:p-8 overflow-hidden">
        <div class="funnel-fill absolute inset-0 bg-electric/10 origin-left scale-x-0"></div>
        <div class="relative flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-electric uppercase tracking-wide">Impressions</p>
            <p class="font-heading text-3xl sm:text-4xl font-bold text-navy funnel-num" data-target="100000">0</p>
          </div>
          <div class="hidden sm:block text-right">
            <p class="text-sm text-gray-700">Your ads shown to the right audience</p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-center">
      <div class="flex items-center gap-2 px-4 py-1.5 bg-sky-tint rounded-full">
        <svg class="w-4 h-4 text-electric" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        <span class="text-sm font-semibold text-electric">3.5% CTR</span>
      </div>
    </div>

    <div class="funnel-stage opacity-0" data-delay="200">
      <div class="relative bg-electric/15 border border-electric/25 rounded-2xl p-6 sm:p-8 mx-4 sm:mx-8 overflow-hidden">
        <div class="funnel-fill absolute inset-0 bg-electric/10 origin-left scale-x-0"></div>
        <div class="relative flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-electric uppercase tracking-wide">Clicks</p>
            <p class="font-heading text-3xl sm:text-4xl font-bold text-navy funnel-num" data-target="3500">0</p>
          </div>
          <div class="hidden sm:block text-right">
            <p class="text-sm text-gray-700">Qualified visitors to your site</p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-center">
      <div class="flex items-center gap-2 px-4 py-1.5 bg-sky-tint rounded-full">
        <svg class="w-4 h-4 text-electric" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        <span class="text-sm font-semibold text-electric">4% Conversion Rate</span>
      </div>
    </div>

    <div class="funnel-stage opacity-0" data-delay="400">
      <div class="relative bg-emerald-500/10 border border-emerald-500/20 rounded-2xl p-6 sm:p-8 mx-8 sm:mx-16 overflow-hidden">
        <div class="funnel-fill absolute inset-0 bg-emerald-500/10 origin-left scale-x-0"></div>
        <div class="relative flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-emerald-600 uppercase tracking-wide">Conversions</p>
            <p class="font-heading text-3xl sm:text-4xl font-bold text-navy funnel-num" data-target="140">0</p>
          </div>
          <div class="hidden sm:block text-right">
            <p class="text-sm text-gray-700">Sales and enquiries</p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-center">
      <div class="flex items-center gap-2 px-4 py-1.5 bg-emerald-50 rounded-full">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        <span class="text-sm font-semibold text-emerald-600">£80 Avg Order Value</span>
      </div>
    </div>

    <div class="funnel-stage opacity-0" data-delay="600">
      <div class="relative bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl p-6 sm:p-8 mx-12 sm:mx-24 shadow-lg shadow-emerald-500/25 overflow-hidden">
        <div class="relative flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-emerald-100 uppercase tracking-wide">Revenue</p>
            <p class="font-heading text-3xl sm:text-4xl font-bold text-white funnel-num" data-target="11200" data-prefix="£">£0</p>
          </div>
          <div class="hidden sm:block text-right">
            <p class="text-sm text-emerald-100">Monthly return on ad spend</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="mt-8 text-center text-slate text-sm">Based on £3,500 monthly spend. Actual results depend on industry, targeting, and landing page quality.</p>
</div>

<script>
  (function () {
    const funnel = document.getElementById('ppc-funnel');
    if (!funnel) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();

        const stages = funnel.querySelectorAll('.funnel-stage');
        stages.forEach((stage) => {
          const delay = parseInt(stage.dataset.delay || '0', 10);
          setTimeout(() => {
            stage.classList.remove('opacity-0');
            stage.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            stage.style.opacity = '1';

            const fill = stage.querySelector('.funnel-fill');
            if (fill) {
              fill.style.transition = 'transform 1s ease-out';
              fill.style.transform = 'scaleX(1)';
            }
          }, delay);
        });

        const nums = funnel.querySelectorAll('.funnel-num');
        nums.forEach((el) => {
          const target = parseInt(el.dataset.target, 10);
          const prefix = el.dataset.prefix || '';
          const delay = parseInt(el.closest('.funnel-stage')?.dataset.delay || '0', 10);
          setTimeout(() => {
            let start = 0;
            const duration = 1200;
            const startTime = performance.now();
            function tick(now) {
              const progress = Math.min((now - startTime) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const val = Math.round(eased * target);
              el.textContent = prefix + val.toLocaleString('en-GB');
              if (progress < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          }, delay + 200);
        });
      });
    }, { threshold: 0.2 });

    observer.observe(funnel);
  })();
</script>
