  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Value-Based Bidding: Feeding Profit into Google Ads",
      "description": "Google bids to the conversion value you send it. Feed profit, not revenue: margin-adjusted values, how to implement them, and what changes once profit is the signal.",
      "url": "https://visible-ads.com/blog/value-based-bidding",
      "datePublished": "2026-07-05",
      "dateModified": "2026-07-05",
      "author": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
