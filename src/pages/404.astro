---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | Visible Ads" description="The page you're looking for doesn't exist or has been moved.">
  <section class="min-h-[70vh] flex items-center justify-center bg-white px-4">
    <div class="text-center max-w-lg">
      <p class="text-[8rem] font-heading font-extrabold leading-none text-electric">404</p>
      <h1 class="text-3xl font-heading font-bold text-navy mt-4">Page Not Found</h1>
      <p class="text-slate-dark mt-4 text-lg">The page you're looking for doesn't exist or has been moved.</p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center px-6 py-3 bg-navy text-white font-semibold rounded-lg hover:bg-navy/90 transition-colors">Go Home</a>
        <a href="/free-ads-audit" class="inline-flex items-center px-6 py-3 bg-electric text-white font-semibold rounded-lg hover:bg-electric-dark transition-colors">Get Free Audit</a>
      </div>
    </div>
  </section>
</Layout>
