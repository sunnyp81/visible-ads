---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Display Advertising Services",
      "serviceType": "Display advertising management",
      "description": "Display advertising management for ecommerce brands: prospecting, retargeting, placement control and honest measurement across the Google Display Network and the Microsoft Audience Network.",
      "url": "https://visible-ads.com/display-advertising",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com/"
      },
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What are display advertising services?", "acceptedAnswer": { "@type": "Answer", "text": "Display advertising means running image and video ads on websites, apps and video placements rather than on a search results page. It covers two jobs. The first puts your brand in front of people who have not searched for you yet. The second brings back people who visited and did not buy. Managing it means choosing placements, controlling frequency, building audiences, briefing the creative and measuring what it contributed." } },
        { "@type": "Question", "name": "Does display advertising work for ecommerce?", "acceptedAnswer": { "@type": "Answer", "text": "Retargeting usually earns its place quickly because the audience already knows you. Prospecting is harder and wastes most display budgets. The honest answer for any brand depends on margin and on whether the measurement is trustworthy. We look at both before recommending a budget." } },
        { "@type": "Question", "name": "Why do display campaigns look better in the ad platform than in GA4?", "acceptedAnswer": { "@type": "Answer", "text": "Display leans heavily on view through conversions. The ad platform counts those and your analytics generally does not. That gap is normal and it is not fraud. It does mean the platform number is not the number your accountant recognises. We reconcile the two before judging a campaign. Scaling on the wrong one is how display budgets quietly lose money." } },
        { "@type": "Question", "name": "Which display networks do you run?", "acceptedAnswer": { "@type": "Answer", "text": "We run the Google Display Network and the Microsoft Audience Network primarily. Paid social placements come in where they suit the audience better. We hold partner status with Google, Microsoft Advertising, Meta and Amazon Ads. Your buyers drive the channel choice rather than what we are set up to sell." } },
        { "@type": "Question", "name": "How do you stop display wasting money on bad placements?", "acceptedAnswer": { "@type": "Answer", "text": "We review placement reports and exclude the bad ones regularly. We cap frequency so you are not paying to annoy the same person. We separate prospecting from retargeting so one cannot hide the performance of the other. Left on default settings display will spend your budget on apps and made for advertising sites you would never have chosen." } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Display Advertising", "item": "https://visible-ads.com/display-advertising" }
      ]
    }
  ]
};

const jobs = [
  {
    title: 'Retargeting',
    body: 'Retargeting brings back people who visited and did not buy. The audience already knows you. This is usually where display earns its place first.',
  },
  {
    title: 'Prospecting',
    body: 'Prospecting reaches people who have not searched for you yet. It is harder and slower and it wastes most display budgets. We treat it as a test with a budget cap rather than an assumption.',
  },
  {
    title: 'Placement control',
    body: 'Left on defaults display will spend on apps and made for advertising sites you would never have picked. We review placement reports and exclude the bad ones.',
  },
  {
    title: 'Frequency discipline',
    body: 'More impressions stop persuading someone at a certain point and start irritating them. Capping frequency is cheaper than buying the irritation.',
  },
  {
    title: 'Creative that has a job',
    body: 'A retargeting ad and a prospecting ad are not the same ad. We brief them against where the person actually is rather than resizing one banner into every slot.',
  },
  {
    title: 'Measurement you can defend',
    body: 'Display leans on view through conversions. We reconcile the platform number against your analytics before deciding anything. Scaling on the wrong one is expensive.',
  },
];

const faqs = [
  {
    question: 'What are display advertising services?',
    answer: 'Display advertising means running image and video ads on websites, apps and video placements rather than on a search results page. It covers two jobs. The first puts your brand in front of people who have not searched for you yet. The second brings back people who visited and did not buy. Managing it means choosing placements, controlling frequency, building audiences, briefing the creative and measuring what it contributed.',
  },
  {
    question: 'Does display advertising work for ecommerce?',
    answer: 'Retargeting usually earns its place quickly because the audience already knows you. Prospecting is harder and wastes most display budgets. The honest answer for any brand depends on margin and on whether the measurement is trustworthy. We look at both before recommending a budget.',
  },
  {
    question: 'Why do display campaigns look better in the ad platform than in GA4?',
    answer: 'Display leans heavily on view through conversions. The ad platform counts those and your analytics generally does not. That gap is normal and it is not fraud. It does mean the platform number is not the number your accountant recognises. We reconcile the two before judging a campaign. Scaling on the wrong one is how display budgets quietly lose money.',
  },
  {
    question: 'Which display networks do you run?',
    answer: 'We run the Google Display Network and the Microsoft Audience Network primarily. Paid social placements come in where they suit the audience better. We hold partner status with Google, Microsoft Advertising, Meta and Amazon Ads. Your buyers drive the channel choice rather than what we are set up to sell.',
  },
  {
    question: 'How do you stop display wasting money on bad placements?',
    answer: 'We review placement reports and exclude the bad ones regularly. We cap frequency so you are not paying to annoy the same person. We separate prospecting from retargeting so one cannot hide the performance of the other. Left on default settings display will spend your budget on apps and made for advertising sites you would never have chosen.',
  },
];
---

<Layout
  title="Display Advertising Services | Visible Ads"
  description="Display advertising managed for profit, not impressions. Prospecting, retargeting, placement control and measurement you can defend to your finance team."
  schema={schema}
>

  <section class="relative overflow-hidden py-20 lg:py-28 bg-white" data-animate>
    <div class="absolute top-20 left-10 w-32 h-32 bg-electric/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-40 h-40 bg-cyan-400/5 rounded-full blur-3xl"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-sky-tint text-electric text-xs font-semibold tracking-wide uppercase mb-5">Display Advertising</span>
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-navy mb-6 leading-tight">Display Advertising Services</h1>
      <p class="text-lg text-gray-700 leading-relaxed mb-6 max-w-2xl mx-auto">Display is the easiest channel in advertising to spend money on and the hardest to prove. Most of it goes on placements nobody chose. A number nobody checks measures the result.</p>
      <p class="text-lg text-gray-700 leading-relaxed mb-10 max-w-2xl mx-auto">We run it the other way round. Prospecting and retargeting stay apart. Placements stay controlled. The platform numbers get reconciled against yours before anyone decides to scale.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/free-ads-audit" class="px-7 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-cta/25">Book a Profit Audit</a>
        <a href="/contact" class="px-7 py-4 rounded-lg border border-gray-200 text-navy font-semibold hover:bg-gray-50 transition-all">Talk to us</a>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">How We Run Display</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Six things decide whether a display budget works or evaporates.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {jobs.map((j) => (
          <div class="bg-white rounded-2xl p-8 shadow-md border border-gray-100 border-t-4 border-electric">
            <h3 class="font-heading text-lg font-bold text-navy mb-3">{j.title}</h3>
            <p class="text-gray-700 text-sm leading-relaxed">{j.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6 text-center">The Number Problem</h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-5">Display has a measurement quirk that catches people out. It leans heavily on view through conversions. Someone saw the ad and did not click and bought later. The ad platform counts that. Your analytics generally does not.</p>
      <p class="text-lg text-gray-700 leading-relaxed mb-5">Neither number is lying. They answer different questions. The platform number is usually the bigger one and it sits on the dashboard. Budgets get scaled against it. That is how a display campaign can look like it is working right up until someone checks the bank account.</p>
      <p class="text-lg text-gray-700 leading-relaxed mb-8">We reconcile the two before recommending anything. We tell you which one we are using when we report. That gap is the first thing worth understanding if your display numbers and your revenue have never agreed.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/roas-vs-profit" class="px-6 py-3 rounded-lg border border-electric text-electric font-semibold hover:bg-sky-tint transition-all">ROAS vs profit</a>
        <a href="/google-ads" class="px-6 py-3 rounded-lg border border-gray-200 text-navy font-semibold hover:bg-gray-50 transition-all">Google Ads</a>
        <a href="/paid-social" class="px-6 py-3 rounded-lg border border-gray-200 text-navy font-semibold hover:bg-gray-50 transition-all">Paid Social</a>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-12 text-center">Frequently Asked Questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
            <h3 class="text-lg font-heading font-bold text-navy mb-3">{faq.question}</h3>
            <p class="text-gray-700 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-4">Find out what your display spend is actually doing</h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">The audit is free and carries no obligation. You keep the findings whether you work with us or not.</p>
      <a href="/free-ads-audit" class="inline-block px-8 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg">Book a Profit Audit</a>
    </div>
  </section>

</Layout>
