---
import Layout from '../layouts/Layout.astro';
import GrowthChart from '../components/GrowthChart.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Google Ads Management",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.optimisedwebsite.com"
      },
      "description": "Award-winning Google Ads management. Google Partner agency delivering 20-40% annual growth through strategic PPC campaigns.",
      "url": "https://visible-ads.optimisedwebsite.com/google-ads",
      "serviceType": "PPC Management",
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does Google Ads management cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our management fees are based on your monthly ad spend and the complexity of your campaigns. Most clients invest between £1,500 and £5,000 per month in management fees, with ad spend on top. We provide a detailed proposal after our free audit so you know exactly what to expect."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly will I see results from Google Ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can see initial traffic within 24 hours of launching campaigns. However, meaningful performance optimisation typically takes 4-8 weeks as we gather conversion data, refine audiences, and test ad copy. Most clients see strong month-on-month improvement from month two onwards."
          }
        },
        {
          "@type": "Question",
          "name": "What are the benefits of working with a Google Partner agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a Google Partner, we have direct access to Google support, beta features, and advanced training. We meet Google's strict performance requirements for client growth and retention. This means you benefit from insider knowledge and early access to new ad formats before your competitors."
          }
        },
        {
          "@type": "Question",
          "name": "How often do you report on campaign performance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide comprehensive monthly reports with full transparency on spend, conversions, ROAS, and strategic recommendations. You also get access to a live dashboard for real-time performance monitoring, and we schedule monthly strategy calls to review results and plan next steps."
          }
        },
        {
          "@type": "Question",
          "name": "Are we locked into a long-term contract?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We work on rolling monthly agreements after an initial 3-month onboarding period. The first three months allow us to properly audit, restructure, and optimise your account. After that, you stay because of results, not contracts."
          }
        }
      ]
    }
  ]
};
---

<Layout title="Google Ads Agency | PPC Management | Visible Ads" description="Award-winning Google Ads management. Google Partner agency delivering 20-40% annual growth through strategic PPC campaigns." schema={schema}>

  <section class="relative py-20 lg:py-28 overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Google Partner Agency</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-white leading-tight mb-6">Google Ads Management That Drives Profitable Growth</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">We manage Google Ads campaigns for ambitious businesses that want more than clicks — they want revenue. From Search and Shopping to Performance Max and remarketing, we build campaigns engineered for profitable growth.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="inline-flex items-center justify-center bg-electric text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric-dark transition-colors text-lg">Get Your Free Google Ads Audit</a>
          <a href="#approach" class="inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See Our Approach</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <section class="py-20 lg:py-28" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">What We Do</h2>
        <p class="text-lg text-slate-dark mb-6 leading-relaxed">We manage every aspect of your Google Ads account — from campaign architecture and keyword strategy to bid management and conversion tracking. Whether you're running Search campaigns to capture high-intent traffic, Shopping campaigns to showcase your products, or Performance Max campaigns to reach customers across Google's entire network, we build and optimise campaigns that deliver measurable return on ad spend.</p>
        <p class="text-lg text-slate-dark mb-6 leading-relaxed">Our team specialises in eCommerce and lead generation accounts where every pound of spend must justify its place. We don't set and forget. Every week, we analyse search term reports, adjust bids, test new ad copy, refine audiences, and eliminate waste. This hands-on management is what separates agencies that deliver 20-40% annual growth from those that simply keep the lights on.</p>
        <p class="text-lg text-slate-dark leading-relaxed">We work across the full Google Ads ecosystem: Search, Shopping, Display, Video, Discovery, and Performance Max. For clients with existing remarketing lists, we build sophisticated retargeting sequences that bring warm prospects back at exactly the right moment. For those starting fresh, we build the foundation properly from day one — structured campaigns, accurate tracking, and a clear measurement framework so you always know what's working.</p>
      </div>
    </div>
  </section>

  <section id="approach" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Approach</h2>
        <p class="text-lg text-slate-dark max-w-2xl mx-auto">A proven four-phase process that turns ad spend into predictable revenue.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Audit & Discovery</h3>
          <p class="text-slate-dark">We tear down your existing account structure, analyse historical performance, review conversion tracking, and identify every pound of wasted spend. Nothing launches until we understand the full picture.</p>
        </div>
        <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Strategy & Structure</h3>
          <p class="text-slate-dark">We build a campaign architecture designed around your business goals — not Google's defaults. Keyword grouping, match types, bid strategies, and audience layering are all planned before a single ad goes live.</p>
        </div>
        <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Launch & Optimise</h3>
          <p class="text-slate-dark">Campaigns go live with rigorous monitoring. We optimise daily during the first month — adjusting bids, pausing underperformers, scaling winners, and refining search terms to eliminate irrelevant traffic.</p>
        </div>
        <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Scale & Grow</h3>
          <p class="text-slate-dark">Once we've established profitable baselines, we scale strategically — expanding into new campaign types, testing new audiences, and increasing budget where the data supports it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Why Choose Us</h2>
        <p class="text-lg text-slate-dark max-w-2xl mx-auto">Numbers that speak louder than promises.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="gradient-border p-8 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">340%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Average ROAS</div>
          <p class="text-slate-dark text-sm">Across our managed accounts, delivering consistent profitable returns on ad spend.</p>
        </div>
        <div class="gradient-border p-8 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">£2M+</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Revenue Managed</div>
          <p class="text-slate-dark text-sm">Annual client revenue generated through our Google Ads campaigns.</p>
        </div>
        <div class="gradient-border p-8 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">97%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Client Retention</div>
          <p class="text-slate-dark text-sm">Clients stay because we deliver results, not because of lock-in contracts.</p>
        </div>
        <div class="gradient-border p-8 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">24hr</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Response Time</div>
          <p class="text-slate-dark text-sm">Every client gets a dedicated account manager with same-day response guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <GrowthChart title="Average Client Performance" bars={[
          { label: "ROAS Improvement", value: 85, color: "#2563EB" },
          { label: "Wasted Spend Reduction", value: 65, color: "#10B981" },
          { label: "Conversion Rate Uplift", value: 45, color: "#2563EB" },
          { label: "Revenue Growth", value: 90, color: "#10B981" },
        ]} />
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 sm:p-12 lg:p-16 max-w-4xl mx-auto">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-6">Case Study</span>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">CFW — From Stagnating Spend to 7-Figure Revenue</h2>
        <p class="text-lg text-slate-dark mb-8 leading-relaxed">When CFW came to us, their Google Ads account was burning budget with diminishing returns. We restructured their entire campaign architecture, implemented granular Shopping feeds, launched Performance Max with curated asset groups, and built a remarketing funnel that recaptured abandoned baskets. The result: a 340% ROAS and 7-figure annual revenue driven directly through Google Ads.</p>
        <div class="flex flex-wrap gap-8">
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">340%</div>
            <div class="text-sm text-slate-dark">Return on Ad Spend</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">7-Figure</div>
            <div class="text-sm text-slate-dark">Annual Revenue</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">-42%</div>
            <div class="text-sm text-slate-dark">Cost Per Acquisition</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How much does Google Ads management cost?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-slate-dark leading-relaxed">Our management fees are based on your monthly ad spend and the complexity of your campaigns. Most clients invest between £1,500 and £5,000 per month in management fees, with ad spend on top. We provide a detailed proposal after our free audit so you know exactly what to expect — no hidden costs, no surprise invoices.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How quickly will I see results from Google Ads?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-slate-dark leading-relaxed">You can see initial traffic within 24 hours of launching campaigns. However, meaningful performance optimisation typically takes 4-8 weeks as we gather conversion data, refine audiences, and test ad copy. Most clients see strong month-on-month improvement from month two onwards.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What are the benefits of working with a Google Partner agency?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-slate-dark leading-relaxed">As a Google Partner, we have direct access to Google support, beta features, and advanced training. We meet Google's strict performance requirements for client growth and retention. This means you benefit from insider knowledge and early access to new ad formats before your competitors.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How often do you report on campaign performance?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-slate-dark leading-relaxed">We provide comprehensive monthly reports with full transparency on spend, conversions, ROAS, and strategic recommendations. You also get access to a live dashboard for real-time monitoring, and we schedule monthly strategy calls to review results and plan next steps.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              Are we locked into a long-term contract?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-slate-dark leading-relaxed">We work on rolling monthly agreements after an initial 3-month onboarding period. The first three months allow us to properly audit, restructure, and optimise your account. After that, you stay because of results, not contracts.</div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos />
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-navy" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Make Your Google Ads Profitable?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free, no-obligation audit of your Google Ads account. We'll show you exactly where you're losing money and how to fix it.</p>
      <a href="/free-ads-audit" class="inline-flex items-center justify-center bg-electric text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric-dark transition-colors text-lg">Get Your Free Google Ads Audit</a>
    </div>
  </section>

</Layout>
